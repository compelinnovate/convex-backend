# syntax=docker/dockerfile:1-labs
# Railway-compatible dashboard image.
# Uses Next standalone output (not the broken pnpm-deploy + server.js hybrid).
FROM ubuntu:noble AS build

RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates build-essential

COPY .nvmrc /nvmrc
RUN <<EOF
NODE_MAJOR=$(cat /nvmrc | cut -d. -f1 | tr -d 'v\n')
curl -fsSL https://deb.nodesource.com/setup_${NODE_MAJOR}.x | bash -
NODE_VERSION=$(cat /nvmrc | tr -d 'v\n')
apt-get install -y --no-install-recommends nodejs=${NODE_VERSION}-1nodesource1
EOF

WORKDIR /app
COPY scripts ./scripts
RUN npm ci --prefix scripts
ENV PATH="/app/scripts/node_modules/.bin:$PATH"
COPY ./npm-packages ./npm-packages
WORKDIR /app/npm-packages
RUN pnpm install --frozen-lockfile
ENV NODE_ENV=production
# Keep Turbopack production build (webpack cannot compile saffron WASM).
RUN turbo run build --filter=dashboard-self-hosted...

FROM ubuntu:noble

COPY .nvmrc /nvmrc
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates
RUN <<EOF
NODE_MAJOR=$(cat /nvmrc | cut -d. -f1 | tr -d 'v\n')
curl -fsSL https://deb.nodesource.com/setup_${NODE_MAJOR}.x | bash -
NODE_VERSION=$(cat /nvmrc | tr -d 'v\n')
apt-get install -y --no-install-recommends nodejs=${NODE_VERSION}-1nodesource1
EOF

RUN groupadd --system --gid 1001 nodejs
RUN useradd --system --uid 1001 --gid nodejs nextjs

WORKDIR /app
# Next nests the app under dashboard-self-hosted because the pnpm workspace root
# is used as the file-tracing root.
COPY --from=build --chown=nextjs:nodejs /app/npm-packages/dashboard-self-hosted/.next/standalone ./
COPY --from=build --chown=nextjs:nodejs /app/npm-packages/dashboard-self-hosted/.next/static ./dashboard-self-hosted/.next/static
COPY --from=build --chown=nextjs:nodejs /app/npm-packages/dashboard-self-hosted/public ./dashboard-self-hosted/public

USER nextjs
WORKDIR /app/dashboard-self-hosted
EXPOSE 6791
ENV NODE_ENV=production
ENV PORT=6791
ENV HOSTNAME=0.0.0.0
CMD ["node", "server.js"]
